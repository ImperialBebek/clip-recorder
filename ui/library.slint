import { Theme } from "theme.slint";
import { Keys, LivePill, Icon, RecordMark } from "widgets.slint";

export struct ClipCard {
    title: string,
    when: string,
    length: string,
    path: string,
    thumb: image,
    selected: bool,
}

export struct PlayerTrack {
    name: string,
    audio: bool,
    muted: bool,
    wave: string,
    volume: float,
}

export struct ToggleRow {
    label: string,
    detail: string,
    on: bool,
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> mono;
    callback picked(int);
    height: 32px;
    border-radius: 8px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.divider;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        alignment: start;
        for o[i] in options: Rectangle {
            width: label.preferred-width + 30px;
            border-radius: 6px;
            background: i == selected ? Theme.key-bg : ta.has-hover ? Theme.card : transparent;
            border-width: i == selected ? 1px : 0;
            border-color: Theme.key-border;
            label := Text {
                text: o;
                font-family: mono ? Theme.mono-font : Theme.body-font;
                font-size: 12px;
                font-weight: i == selected ? 600 : 400;
                color: i == selected ? Theme.text : Theme.muted;
            }
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

component Choices inherits VerticalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    spacing: 2px;
    Rectangle {
        background: Theme.sidebar;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.divider;
        VerticalLayout {
            padding: 3px;
            spacing: 2px;
            for o[i] in options: Rectangle {
                height: 28px;
                border-radius: 6px;
                background: i == selected ? Theme.key-bg : ta.has-hover ? Theme.card : transparent;
                border-width: i == selected ? 1px : 0;
                border-color: Theme.key-border;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: o;
                        font-family: Theme.body-font;
                        font-size: 12px;
                        font-weight: i == selected ? 600 : 400;
                        color: i == selected ? Theme.text : Theme.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if i == selected: Icon {
                        name: "check";
                        width: 12px;
                        height: 12px;
                        stroke: Theme.text;
                        y: (parent.height - self.height) / 2;
                    }
                }
                ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
            }
        }
    }
}

component Toggles inherits VerticalLayout {
    in property <[ToggleRow]> rows;
    callback toggled(int);
    spacing: 2px;
    Rectangle {
        background: Theme.sidebar;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.divider;
        VerticalLayout {
            padding: 3px;
            spacing: 2px;
            for r[i] in rows: Rectangle {
                height: 28px;
                border-radius: 6px;
                background: r.on ? Theme.key-bg : ta.has-hover ? Theme.card : transparent;
                border-width: r.on ? 1px : 0;
                border-color: Theme.key-border;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: r.label;
                        font-family: Theme.body-font;
                        font-size: 12px;
                        font-weight: r.on ? 600 : 400;
                        color: r.on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: r.detail;
                        font-family: Theme.body-font;
                        font-size: 11px;
                        color: Theme.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if r.on: Icon {
                        name: "check";
                        width: 12px;
                        height: 12px;
                        stroke: Theme.text;
                        y: (parent.height - self.height) / 2;
                    }
                }
                ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(i); } }
            }
        }
    }
}

component ResizeHandle inherits TouchArea {
    in property <int> dir;
    in property <MouseCursor> cursor;
    callback resize(int, length, length);
    mouse-cursor: cursor;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.resize(dir, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

component VolumeSlider inherits Rectangle {
    in property <float> value;
    in property <float> max: 1;
    callback changed(float);
    height: 20px;
    Rectangle {
        x: 0;
        y: 8px;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.key-bg;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value / root.max, 0, 1);
            height: 100%;
            border-radius: 2px;
            background: Theme.muted;
        }
    }
    if root.max > 1: Rectangle {
        x: parent.width / root.max - 0.5px;
        y: 6px;
        width: 1px;
        height: 8px;
        background: Theme.divider;
    }
    Rectangle {
        x: clamp(root.value / root.max * parent.width - 5px, 0px, parent.width - 10px);
        y: 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.text;
    }
    TouchArea {
        moved => {
            if self.pressed {
                root.changed(root.pick(self.mouse-x));
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.changed(root.pick(self.mouse-x));
            }
        }
    }
    // Snap to exactly 1.0 within 4% of max of it.
    pure function pick(x: length) -> float {
        abs(clamp(x / root.width, 0, 1) * root.max - 1) < 0.04 * root.max ? 1 : clamp(x / root.width, 0, 1) * root.max
    }
}

component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 8px;
    HorizontalLayout {
        Text { text: title; font-family: Theme.body-font; font-size: 13px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
        Text { text: note; font-family: Theme.mono-font; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
    }
    @children
}

component Step inherits HorizontalLayout {
    in property <string> num;
    in property <string> title;
    in property <string> body;
    spacing: 14px;
    Rectangle {
        y: 0;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: Theme.red-dim;
        Text { text: num; color: Theme.red; font-family: Theme.mono-font; font-size: 12px; font-weight: 600; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Text { text: title; vertical-alignment: center; font-family: Theme.body-font; font-size: 14px; font-weight: 600; color: Theme.text; }
            @children
        }
        Text { text: body; wrap: word-wrap; font-family: Theme.body-font; font-size: 12px; color: Theme.muted; }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    width: t.preferred-width + 28px;
    border-radius: 6px;
    opacity: enabled ? 1 : 0.4;
    background: danger ? (ta.has-hover && enabled ? #ff5247 : Theme.red) : (ta.has-hover && enabled ? Theme.card-hover : Theme.key-bg);
    border-width: danger ? 0 : 1px;
    border-color: Theme.key-border;
    t := Text {
        text: label;
        font-family: Theme.body-font;
        font-size: 12px;
        font-weight: 600;
        color: danger ? white : Theme.text;
    }
    ta := TouchArea { mouse-cursor: enabled ? pointer : default; clicked => { if root.enabled { root.clicked(); } } }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> round;
    callback clicked;
    width: round ? 28px : 32px;
    height: self.width;
    border-radius: round ? self.width / 2 : 8px;
    background: active || ta.has-hover ? Theme.card-hover : round ? Theme.key-bg : transparent;
    Icon { name: icon; stroke: Theme.text; width: round ? 14px : 16px; height: self.width; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    in property <ClipCard> item;
    // Checkbox visible: select mode, or Ctrl/Shift held as a hint.
    in property <bool> show-check;
    in property <bool> hovered;
    property <length> thumb-height: self.width * 9 / 16;
    height: thumb-height + 34px;
    Rectangle {
        y: 0;
        height: thumb-height;
        border-radius: 8px;
        clip: true;
        background: Theme.card;
        Image { width: 100%; height: 100%; source: item.thumb; image-fit: cover; }
        if hovered: Rectangle { background: #ffffff10; }
        Rectangle {
            background: #ff3b2f22;
            border-width: 2px;
            border-color: Theme.red;
            border-radius: 8px;
            opacity: item.selected ? 1 : 0;
            animate opacity { duration: 140ms; easing: ease-out; }
        }
        // Fades in and grows from 70% so it doesn't pop in when Ctrl/Shift is pressed.
        Rectangle {
            x: 8px;
            y: 8px;
            width: 20px;
            height: 20px;
            opacity: show-check ? 1 : 0;
            animate opacity { duration: 160ms; easing: ease-out; }
            Rectangle {
                property <float> grow: show-check ? 1 : 0;
                animate grow { duration: 160ms; easing: ease-out; }
                width: 20px * (0.7 + 0.3 * self.grow);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: item.selected ? Theme.red : #0e0f11b0;
                border-width: 1.5px;
                border-color: item.selected ? Theme.red : Theme.text;
                animate background, border-color { duration: 120ms; }
                Icon {
                    name: "check";
                    stroke: white;
                    x: 3px;
                    y: 3px;
                    width: 14px;
                    height: 14px;
                    opacity: item.selected ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }
            }
        }
        Rectangle {
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            width: len.preferred-width + 12px;
            height: 20px;
            border-radius: 4px;
            background: #0e0f11d0;
            len := Text { text: item.length; font-family: Theme.mono-font; font-size: 11px; font-weight: 500; color: Theme.text; }
        }
    }
    HorizontalLayout {
        y: thumb-height + 10px;
        height: 18px;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 8px;
        Text { text: item.title; overflow: elide; font-family: Theme.body-font; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: item.when; font-family: Theme.mono-font; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
    }
}

export component Library inherits Window {
    in property <[ClipCard]> clips;
    in property <bool> live;
    in property <string> state-label: "Stopped";
    in property <string> folder-text;
    in property <[string]> hotkey: ["Alt", "S"];
    in property <int> seconds: 60;
    in property <int> quality: 1;
    in property <int> duration: 1;
    in property <string> quality-note;
    in property <string> duration-note;
    in property <[string]> mics;
    in property <int> mic: 1;
    callback set-mic(int);
    callback load-mics();
    in property <[ToggleRow]> app-tracks;
    callback toggle-app-track(int);
    in-out property <bool> popover;
    in-out property <bool> select-mode;
    // Ctrl or Shift is down: show the selection circles as a hint.
    in-out property <bool> mod-held;
    in-out property <bool> confirming;
    in property <int> selected-count;
    callback grid-click(length, length, length, length, length, int, bool, bool);
    callback band-start(bool);
    callback band-select(length, length, length, length, length, length, length, int);
    callback toggle-select-mode();
    callback select-all(bool);
    callback delete-selected();
    callback set-quality(int);
    callback set-duration(int);
    callback start-recorder();
    callback change-screen();
    // First start: a welcome card over the library explaining how the app works.
    in-out property <bool> onboarding;
    callback finish-onboarding();
    // The built-in player: a page that replaces the grid for the open clip.
    in-out property <bool> player-open;
    in-out property <bool> fullscreen;
    in property <string> player-title;
    in property <string> player-time;
    in property <[PlayerTrack]> tracks;
    in property <[image]> filmstrip;
    in property <image> frame;
    in property <float> pos;
    in property <float> dur;
    in-out property <bool> scrubbing;
    in-out property <float> scrub-pos;
    property <float> shown-frac: dur > 0 ? clamp((scrubbing ? scrub-pos : pos) / dur, 0, 1) : 0;
    in property <bool> playing;
    in property <float> volume: 1;
    in property <bool> muted;
    in-out property <bool> player-confirming;
    callback player-back();
    callback toggle-play();
    callback seek(float);
    callback prev-clip();
    callback next-clip();
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-track(int);
    callback set-track-volume(int, float);
    callback open-external();
    callback show-folder();
    callback delete-current();
    callback toggle-fullscreen();
    // False when the recorder follows the game window and there is no screen to pick.
    in property <bool> screen-picker: true;
    // Both take the pointer's window position.
    callback drag(length, length);
    // 0 N, 1 S, 2 W, 3 E, 4 NW, 5 NE, 6 SW, 7 SE.
    callback resize(int, length, length);
    callback close-window();

    changed popover => { if popover { root.load-mics(); } }

    title: "Clips";
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 360px;
    no-frame: true;
    background: Theme.bg;

    fs := FocusScope {
        key-released(e) => {
            // The released key may still be reported in `modifiers`, so leave it out.
            root.mod-held = (e.modifiers.control && e.text != Key.Control) || (e.modifiers.shift && e.text != Key.Shift);
            reject
        }
        key-pressed(e) => {
            root.mod-held = e.modifiers.control || e.modifiers.shift;
            if root.player-open {
                if e.text == Key.Escape {
                    if root.fullscreen { root.toggle-fullscreen(); }
                    else if root.player-confirming { root.player-confirming = false; }
                    else { root.player-back(); }
                    return accept;
                }
                if root.player-confirming {
                    if e.text == Key.Return && !e.repeat { root.delete-current(); }
                    return accept;
                }
                if e.text == " " || e.text == "k" || e.text == "K" { root.toggle-play(); return accept; }
                if e.text == Key.LeftArrow { root.seek(max(root.pos - 5, 0)); return accept; }
                if e.text == Key.RightArrow { root.seek(min(root.pos + 5, root.dur)); return accept; }
                if e.text == Key.UpArrow { root.set-volume(min(root.volume + 0.1, 1)); return accept; }
                if e.text == Key.DownArrow { root.set-volume(max(root.volume - 0.1, 0)); return accept; }
                if e.text == "m" || e.text == "M" { root.toggle-mute(); return accept; }
                if e.text == "f" || e.text == "F" { root.toggle-fullscreen(); return accept; }
                if e.text == Key.PageUp { root.prev-clip(); return accept; }
                if e.text == Key.PageDown { root.next-clip(); return accept; }
                if e.text == Key.Delete && !e.repeat { root.player-confirming = true; return accept; }
                return accept;
            }
            if e.text == Key.Escape {
                if confirming { confirming = false; } else if select-mode { root.toggle-select-mode(); } else if popover { popover = false; } else { root.close-window(); }
                return accept;
            }
            if clips.length > 0 && e.modifiers.control && (e.text == "a" || e.text == "A") && !popover {
                root.select-all(false);
                return accept;
            }
            // Auto-repeat of a held key is swallowed: one deliberate press per step,
            // so holding Delete can never walk from "ask" straight to "delete".
            if select-mode && !popover && (e.text == Key.Delete || e.text == Key.Backspace) {
                if !e.repeat {
                    if confirming { root.delete-selected(); } else if selected-count > 0 { confirming = true; }
                }
                return accept;
            }
            if confirming && e.text == Key.Return {
                if !e.repeat { root.delete-selected(); }
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Header doubles as the title bar.
            if !root.fullscreen: Rectangle {
                height: 52px;
                TouchArea { pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    spacing: 12px;
                    if root.player-open: IconButton { y: (parent.height - self.height) / 2; icon: "back"; clicked => { root.player-back(); } }
                    if !root.player-open: RecordMark { size: 16px; y: (parent.height - 16px) / 2; }
                    Text { text: root.player-open ? root.player-title : "Clips"; font-family: Theme.body-font; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    LivePill {
                        y: (parent.height - self.height) / 2;
                        live: root.live;
                        label: root.state-label;
                        TouchArea { mouse-cursor: root.live ? default : pointer; clicked => { if !root.live { root.start-recorder(); } } }
                    }
                    if !root.player-open && clips.length > 0: IconButton { y: (parent.height - self.height) / 2; icon: "check"; active: root.select-mode; clicked => { root.toggle-select-mode(); } }
                    if !root.player-open: IconButton { y: (parent.height - self.height) / 2; icon: "sliders"; active: root.popover; clicked => { root.popover = !root.popover; } }
                    Rectangle { width: 1px; height: 20px; y: (parent.height - 20px) / 2; background: Theme.border; }
                    IconButton { y: (parent.height - self.height) / 2; icon: "close"; round: true; clicked => { root.close-window(); } }
                }
            }
            if !root.fullscreen: Rectangle { height: 1px; background: Theme.divider; }

            if !root.player-open && clips.length == 0: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    HorizontalLayout { alignment: center; Keys { keys: root.hotkey; } }
                    Text { text: "No clips yet"; horizontal-alignment: center; font-family: Theme.display-font; font-size: 30px; font-weight: 500; color: Theme.text; }
                    Text {
                        text: "Already recording in the background. Play something,\nthen press \{root.hotkey[0]}+\{root.hotkey[1]} to keep the last \{root.seconds} seconds.";
                        horizontal-alignment: center;
                        font-family: Theme.body-font;
                        font-size: 13px;
                        color: Theme.muted;
                    }
                }
            }

            if !root.player-open && clips.length > 0: VerticalLayout {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 12px;
                    Text { text: clips.length == 1 ? "1 clip" : "\{clips.length} clips"; font-family: Theme.body-font; font-size: 12px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
                    Text { text: root.folder-text; font-family: Theme.mono-font; font-size: 10px; color: Theme.faint; vertical-alignment: center; }
                }
                Flickable {
                    property <length> gap: 16px;
                    property <int> cols: max(1, floor((self.width - 48px + gap) / (260px + gap)));
                    property <length> card-width: (self.width - 48px - (cols - 1) * gap) / cols;
                    property <length> card-height: card-width * 9 / 16 + 34px;
                    property <int> hover-col: floor((grid.mouse-x - 24px) / (card-width + gap));
                    property <int> hover-row: floor(grid.mouse-y / (card-height + gap));
                    property <int> hover-index: grid.has-hover && !grid.dragging && hover-col >= 0 && hover-col < cols
                        && mod(grid.mouse-x - 24px, card-width + gap) <= card-width
                        && mod(grid.mouse-y, card-height + gap) <= card-height
                        && hover-row * cols + hover-col < clips.length ? hover-row * cols + hover-col : -1;
                    interactive: false;
                    content-height: ceil(clips.length / cols) * (card-height + gap) + 8px;
                    for c[i] in clips: Card {
                        x: 24px + mod(i, cols) * (card-width + gap);
                        y: floor(i / cols) * (card-height + gap);
                        width: card-width;
                        item: c;
                        show-check: root.select-mode || (root.mod-held && fs.has-focus);
                        hovered: i == parent.hover-index;
                    }
                    // One touch area for the whole grid: click, Ctrl/Shift+click and drag-to-select.
                    grid := TouchArea {
                        property <bool> dragging;
                        property <length> press-x;
                        property <length> press-y;
                        property <bool> extend;
                        // Without x/y Slint centres it in the viewport, which shifts the hit area.
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: max(parent.content-height, parent.height);
                        mouse-cursor: parent.hover-index >= 0 ? pointer : default;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                                self.extend = e.modifiers.control || e.modifiers.shift;
                                root.mod-held = self.extend;
                                self.dragging = false;
                            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                if self.dragging {
                                    self.dragging = false;
                                } else {
                                    root.grid-click(self.mouse-x, self.mouse-y, parent.card-width, parent.card-height, parent.gap, parent.cols, e.modifiers.control, e.modifiers.shift);
                                }
                            } else if e.kind == PointerEventKind.cancel {
                                self.dragging = false;
                            }
                        }
                        moved => {
                            if self.pressed && !self.dragging && (abs(self.mouse-x - self.press-x) > 6px || abs(self.mouse-y - self.press-y) > 6px) {
                                self.dragging = true;
                                root.band-start(self.extend);
                            }
                            if self.dragging {
                                root.band-select(min(self.press-x, self.mouse-x), min(self.press-y, self.mouse-y), max(self.press-x, self.mouse-x), max(self.press-y, self.mouse-y), parent.card-width, parent.card-height, parent.gap, parent.cols);
                            }
                        }
                    }
                    if grid.dragging: Rectangle {
                        x: min(grid.press-x, grid.mouse-x);
                        y: min(grid.press-y, grid.mouse-y);
                        width: abs(grid.mouse-x - grid.press-x);
                        height: abs(grid.mouse-y - grid.press-y);
                        background: #ff3b2f1a;
                        border-width: 1px;
                        border-color: Theme.red;
                        border-radius: 4px;
                    }
                }
            }

            if root.player-open: VerticalLayout {
                vertical-stretch: 1;
                Rectangle {
                    vertical-stretch: 1;
                    background: black;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.frame;
                        image-fit: contain;
                    }
                    TouchArea {
                        clicked => { root.toggle-play(); }
                        double-clicked => { root.toggle-fullscreen(); }
                    }
                }
                if root.fullscreen: Rectangle {
                    height: 6px;
                    background: Theme.divider;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * root.shown-frac;
                        background: Theme.red;
                    }
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.scrubbing = true;
                                root.scrub-pos = clamp(self.mouse-x / max(self.width, 1px), 0, 1) * root.dur;
                                root.seek(root.scrub-pos);
                            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.scrubbing {
                                root.seek(root.scrub-pos);
                                root.scrubbing = false;
                            } else if e.kind == PointerEventKind.cancel {
                                root.scrubbing = false;
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.scrub-pos = clamp(self.mouse-x / max(self.width, 1px), 0, 1) * root.dur;
                                root.seek(root.scrub-pos);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        IconButton { y: (parent.height - self.height) / 2; icon: "prev"; clicked => { root.prev-clip(); } }
                        IconButton { y: (parent.height - self.height) / 2; icon: root.playing ? "pause" : "play"; clicked => { root.toggle-play(); } }
                        IconButton { y: (parent.height - self.height) / 2; icon: "next"; clicked => { root.next-clip(); } }
                        Text { text: root.player-time; font-family: Theme.mono-font; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.player-confirming: IconButton { y: (parent.height - self.height) / 2; icon: root.muted ? "mute" : "volume"; clicked => { root.toggle-mute(); } }
                        if !root.player-confirming: VolumeSlider {
                            y: (parent.height - self.height) / 2;
                            width: 80px;
                            value: root.volume;
                            changed(v) => { root.set-volume(v); }
                        }
                        if !root.player-confirming: IconButton { y: (parent.height - self.height) / 2; icon: "external"; clicked => { root.open-external(); } }
                        if !root.player-confirming: IconButton { y: (parent.height - self.height) / 2; icon: "folder"; clicked => { root.show-folder(); } }
                        if !root.player-confirming: IconButton { y: (parent.height - self.height) / 2; icon: "trash"; clicked => { root.player-confirming = true; } }
                        if !root.player-confirming: IconButton { y: (parent.height - self.height) / 2; icon: "fullscreen"; clicked => { root.toggle-fullscreen(); } }
                        if root.player-confirming: Text { text: "Delete this clip? This can't be undone."; font-family: Theme.body-font; font-size: 12px; font-weight: 600; color: Theme.red; vertical-alignment: center; }
                        if root.player-confirming: TextButton { label: "Keep"; clicked => { root.player-confirming = false; } }
                        if root.player-confirming: TextButton { label: "Delete"; danger: true; clicked => { root.delete-current(); } }
                    }
                }
                if !root.fullscreen: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    spacing: 2px;
                    for t[i] in root.tracks: HorizontalLayout {
                        spacing: 8px;
                        height: t.audio ? 36px : 48px;
                        HorizontalLayout {
                            width: 188px;
                            spacing: 4px;
                            Text {
                                text: t.name;
                                font-family: Theme.body-font;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if t.audio: IconButton {
                                y: (parent.height - self.height) / 2;
                                round: true;
                                icon: t.muted ? "mute" : "volume";
                                clicked => { root.toggle-track(i); }
                            }
                            if t.audio: VolumeSlider {
                                y: (parent.height - self.height) / 2;
                                width: 56px;
                                max: 2;
                                value: t.volume;
                                changed(v) => { root.set-track-volume(i, v); }
                            }
                            if t.audio: Text {
                                text: "\{round(t.volume * 100)}%";
                                font-family: Theme.mono-font;
                                font-size: 10px;
                                color: Theme.muted;
                                width: 34px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        lane := Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.sidebar;
                            border-radius: 6px;
                            clip: true;
                            opacity: t.muted ? 0.4 : 1;
                            if !t.audio: HorizontalLayout {
                                for img in root.filmstrip: Image {
                                    horizontal-stretch: 1;
                                    source: img;
                                    image-fit: cover;
                                }
                            }
                            if t.audio: Path {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                commands: t.wave;
                                viewbox-width: 600;
                                viewbox-height: 2;
                                fill: Theme.muted;
                                stroke: transparent;
                            }
                            Rectangle {
                                x: 0;
                                y: 0;
                                height: 100%;
                                width: parent.width * root.shown-frac;
                                background: #ffffff0d;
                            }
                            Rectangle {
                                x: parent.width * root.shown-frac - 1px;
                                y: 0;
                                width: 2px;
                                height: 100%;
                                background: Theme.red;
                            }
                            ta := TouchArea {
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                        root.scrubbing = true;
                                        root.scrub-pos = clamp(self.mouse-x / max(self.width, 1px), 0, 1) * root.dur;
                                        root.seek(root.scrub-pos);
                                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.scrubbing {
                                        root.seek(root.scrub-pos);
                                        root.scrubbing = false;
                                    } else if e.kind == PointerEventKind.cancel {
                                        root.scrubbing = false;
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.scrub-pos = clamp(self.mouse-x / max(self.width, 1px), 0, 1) * root.dur;
                                        root.seek(root.scrub-pos);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !root.player-open: Rectangle { height: 1px; background: Theme.divider; }
            if !root.player-open && !select-mode: HorizontalLayout {
                height: 44px;
                alignment: center;
                spacing: 6px;
                Text { text: "Press"; font-family: Theme.body-font; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                Keys { keys: root.hotkey; padding-top: 12px; padding-bottom: 12px; }
                Text { text: "in any game to save the last \{root.seconds} s"; font-family: Theme.body-font; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
            }
            if !root.player-open && select-mode: HorizontalLayout {
                height: 44px;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                Text {
                    text: confirming ? (selected-count == 1 ? "Delete 1 clip? This can't be undone." : "Delete \{selected-count} clips? This can't be undone.") : selected-count == 0 ? "Select clips to delete" : "\{selected-count} selected";
                    font-family: Theme.body-font;
                    font-size: 12px;
                    font-weight: 600;
                    color: confirming ? Theme.red : Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if !confirming: TextButton { label: "Select all"; clicked => { root.select-all(true); } }
                if !confirming: TextButton { label: "Cancel"; clicked => { root.toggle-select-mode(); } }
                if !confirming: TextButton { label: "Delete"; danger: true; enabled: selected-count > 0; clicked => { root.confirming = true; } }
                if confirming: TextButton { label: "Keep"; clicked => { root.confirming = false; } }
                if confirming: TextButton { label: "Delete"; danger: true; clicked => { root.delete-selected(); } }
            }
        }

        if root.onboarding: Rectangle {
            background: #000000b8;
            TouchArea { }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: max(16px, (parent.height - self.height) / 2);
                width: min(460px, parent.width - 32px);
                height: ob.preferred-height;
                background: Theme.card;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 32px;
                drop-shadow-color: #000000a0;
                ob := VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Welcome to Clip Recorder"; font-family: Theme.body-font; font-size: 20px; font-weight: 600; color: Theme.text; }
                        Text { text: "Instant replay for your games, with nothing to set up."; wrap: word-wrap; font-family: Theme.body-font; font-size: 13px; color: Theme.muted; }
                    }
                    Step {
                        num: "1";
                        title: root.screen-picker ? "Pick your screen once" : "Just play";
                        body: root.screen-picker
                            ? "Choose the screen your games run on when asked. After that it keeps the last " + root.seconds + " s of it in memory. Nothing is written to disk until you save."
                            : "Clip Recorder spots your game on its own and keeps the last " + root.seconds + " s of it in memory. Nothing is written to disk until you save.";
                    }
                    Step {
                        num: "2";
                        title: "Save a clip with";
                        body: "The last " + root.seconds + " s become an MP4 and appear here in the library. A toast confirms it, even over a fullscreen game.";
                        Keys { keys: root.hotkey; }
                    }
                    Step {
                        num: "3";
                        title: "It lives in the tray";
                        body: "Closing this window doesn't stop recording. Click the tray icon to come back, or choose Quit from its menu to stop.";
                    }
                    HorizontalLayout {
                        alignment: end;
                        TextButton { height: 32px; danger: true; label: "Got it"; clicked => { root.finish-onboarding(); } }
                    }
                }
            }
        }

        if popover: TouchArea { clicked => { root.popover = false; } }
        if popover: Rectangle {
            x: parent.width - self.width - 52px;
            y: 48px;
            width: 300px;
            height: min(pop.preferred-height, root.height - 64px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            TouchArea { }
            // Scrolls the settings when the window is too short to fit them.
            Flickable {
                width: 100%;
                height: min(pop.preferred-height, root.height - 64px);
                content-height: pop.preferred-height;
                pop := VerticalLayout {
                padding: 16px;
                spacing: 16px;
                SettingRow {
                    title: "Quality";
                    note: root.quality-note;
                    Segmented { options: ["Light", "High", "Max"]; selected: root.quality; picked(i) => { root.set-quality(i); } }
                }
                SettingRow {
                    title: "Duration";
                    note: root.duration-note;
                    Segmented { mono: true; options: ["30 s", "60 s", "120 s"]; selected: root.duration; picked(i) => { root.set-duration(i); } }
                }
                SettingRow {
                    title: "App audio";
                    note: "own track each";
                    Toggles { rows: root.app-tracks; toggled(i) => { root.toggle-app-track(i); } }
                }
                SettingRow {
                    title: "Microphone";
                    note: "own audio track";
                    Choices { options: root.mics; selected: root.mic; picked(i) => { root.set-mic(i); } }
                }
                if root.screen-picker: SettingRow {
                    title: "Screen";
                    note: "the one a game runs on";
                    TextButton { height: 28px; label: "Change screen…"; clicked => { root.popover = false; root.change-screen(); } }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                Text {
                    text: "Applies instantly. Encoder and folder are picked for you.";
                    wrap: word-wrap;
                    font-family: Theme.body-font;
                    font-size: 11px;
                    color: Theme.faint;
                }
                }
            }
        }

        // Frameless window: resize handles along the edges, on top of everything.
        if !root.fullscreen: Rectangle {
            property <length> edge: 6px;
            property <length> corner: 12px;
            ResizeHandle { x: corner; y: 0; width: parent.width - 2 * corner; height: edge; cursor: MouseCursor.ns-resize; dir: 0; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: corner; y: parent.height - edge; width: parent.width - 2 * corner; height: edge; cursor: MouseCursor.ns-resize; dir: 1; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: 0; y: corner; width: edge; height: parent.height - 2 * corner; cursor: MouseCursor.ew-resize; dir: 2; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: parent.width - edge; y: corner; width: edge; height: parent.height - 2 * corner; cursor: MouseCursor.ew-resize; dir: 3; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: 0; y: 0; width: corner; height: corner; cursor: MouseCursor.nwse-resize; dir: 4; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: parent.width - corner; y: 0; width: corner; height: corner; cursor: MouseCursor.nesw-resize; dir: 5; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: 0; y: parent.height - corner; width: corner; height: corner; cursor: MouseCursor.nesw-resize; dir: 6; resize(d, x, y) => { root.resize(d, x, y); } }
            ResizeHandle { x: parent.width - corner; y: parent.height - corner; width: corner; height: corner; cursor: MouseCursor.nwse-resize; dir: 7; resize(d, x, y) => { root.resize(d, x, y); } }
        }
    }
    init => { fs.focus(); }
}
