import { Theme } from "theme.slint";
import { Keys, LivePill, BufferBars, Toggle, Icon, RecordMark } from "widgets.slint";
import { Button } from "firstrun.slint";

component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    in property <string> label: index >= 0 && index < options.length ? options[index] : "";
    callback selected(int);
    callback clicked-custom;
    in property <bool> custom;
    height: 32px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.card-hover : #1a1b1e;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            vertical-alignment: center;
            font-family: Theme.mono-font;
            font-size: 12px;
            color: Theme.text;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Icon { name: "chevron"; stroke: Theme.muted; y: (parent.height - 16px) / 2; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if custom { root.clicked-custom(); } else { popup.show(); }
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: #1a1b1e;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                for o[i] in options: Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: ota.has-hover ? Theme.card-hover : transparent;
                    Text {
                        x: 8px;
                        text: o;
                        font-family: Theme.mono-font;
                        font-size: 12px;
                        color: i == index ? Theme.red : Theme.text;
                    }
                    ota := TouchArea { clicked => { root.selected(i); } }
                }
            }
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback selected(int);
    height: 32px;
    width: row.preferred-width + 6px;
    border-radius: 8px;
    background: #1a1b1e;
    border-width: 1px;
    border-color: Theme.border;
    row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in options: Rectangle {
            width: t.preferred-width + 24px;
            border-radius: 6px;
            background: i == index ? #2a2b30 : transparent;
            t := Text {
                text: o;
                font-family: Theme.body-font;
                font-size: 12px;
                font-weight: i == index ? 600 : 400;
                color: i == index ? Theme.text : Theme.muted;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.selected(i); } }
        }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    padding-left: 2px;
    padding-right: 2px;
    height: 28px;
    Text { text: title; font-family: Theme.body-font; font-size: 11px; font-weight: 600; letter-spacing: 1px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
    Text { text: note; font-family: Theme.body-font; font-size: 10px; color: Theme.faint; vertical-alignment: center; }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
}

// One setting: title and description on the left, a control on the right.
component Row inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> first;
    in property <length> control-width: 160px;
    min-height: 62px;
    if !first: Rectangle { y: 0; height: 1px; background: Theme.divider; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: title; font-family: Theme.body-font; font-size: 13px; font-weight: 600; color: Theme.text; }
            Text { text: description; wrap: word-wrap; font-family: Theme.body-font; font-size: 11px; color: Theme.muted; }
        }
        HorizontalLayout {
            alignment: end;
            width: control-width;
            VerticalLayout { alignment: center; @children }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: active ? #1c1d21 : ta.has-hover ? #17181b : transparent;
    if active: Rectangle { x: 0; width: 2px; height: 18px; background: Theme.red; border-radius: 1px; }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        Icon { name: "monitor"; stroke: active ? Theme.text : Theme.muted; y: (parent.height - 16px) / 2; width: 14px; height: 14px; }
        Text { text: label; vertical-alignment: center; font-family: Theme.body-font; font-size: 13px; font-weight: active ? 600 : 400; color: active ? Theme.text : Theme.muted; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Settings inherits Window {
    in property <bool> live: true;
    in property <bool> paused;
    in property <string> state-label: "Live · 60 s buffer";
    in property <string> buffer-text: "00:00 / 01:00";
    in property <float> fill;
    in property <string> ram-text;
    in property <string> encoder-line;
    in property <[string]> hotkey: ["Alt", "S"];
    in property <string> hotkey-text: "Alt+S";
    in property <string> hotkey-backend;
    in property <string> gpu-text;
    in property <string> warning;
    in property <[string]> encoder-options;
    in property <int> encoder-index;
    in property <int> quality-index: 1;
    in property <string> bitrate-text;
    in property <string> output-text: "~/Videos/Clips";
    in property <string> name-example;
    in property <[string]> length-options;
    in property <int> length-index;
    in property <[string]> fps-options;
    in property <int> fps-index;
    in property <[string]> audio-options;
    in property <int> audio-index;
    in property <string> audio-active;
    in property <string> storage-text;
    in-out property <bool> pause-without-game;
    in-out property <bool> toast: true;
    in-out property <bool> sound;
    in property <string> version-text;
    in property <string> pipewire-text;
    in property <bool> connected: true;
    in-out property <int> page;

    callback save-now();
    callback toggle-pause();
    callback set-encoder(int);
    callback set-quality(int);
    callback set-length(int);
    callback set-fps(int);
    callback set-audio(int);
    callback choose-folder();
    callback open-folder();
    callback set-pause-without-game(bool);
    callback set-toast(bool);
    callback set-sound(bool);
    callback reselect();
    callback start-recorder();

    title: "Clip Recorder";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1060px;
    min-height: 640px;
    background: Theme.bg;

    HorizontalLayout {
        Rectangle {
            width: 232px;
            background: Theme.sidebar;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.divider; }
            VerticalLayout {
                padding: 12px;
                padding-top: 22px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-bottom: 18px;
                    spacing: 10px;
                    RecordMark { size: 16px; y: (parent.height - 16px) / 2; }
                    Text { text: "Clip Recorder"; font-family: Theme.display-font; font-size: 20px; font-weight: 500; color: Theme.text; }
                }
                for p[i] in ["General", "Capture", "Audio", "Hotkey", "Storage"]: NavItem {
                    label: p;
                    active: root.page == i;
                    clicked => { root.page = i; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { padding-left: 8px; Text { text: version-text; font-family: Theme.mono-font; font-size: 10px; color: Theme.faint; } }
                HorizontalLayout { padding-left: 8px; Text { text: pipewire-text; font-family: Theme.mono-font; font-size: 10px; color: Theme.faint; } }
                Rectangle { height: 8px; }
            }
        }
        VerticalLayout {
            padding: 48px;
            padding-top: 36px;
            spacing: 0;
            HorizontalLayout {
                Text {
                    text: ["General", "Capture", "Audio", "Hotkey", "Storage"][page];
                    font-family: Theme.display-font;
                    font-size: 28px;
                    font-weight: 500;
                    color: Theme.text;
                }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                Text {
                    text: "Runs in the tray. Press the hotkey in any game to keep what just happened.";
                    font-family: Theme.body-font;
                    font-size: 13px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                LivePill { live: root.live; label: root.state-label; }
            }
            Rectangle { height: 24px; }
            if !connected: Card {
                height: 64px;
                HorizontalLayout {
                    padding: 14px;
                    Text { text: "The recorder is not running."; font-family: Theme.body-font; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { label: "Start recording"; primary: true; clicked => { root.start-recorder(); } }
                }
            }
            if connected && page == 0: HorizontalLayout {
                spacing: 24px;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    alignment: start;
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            HorizontalLayout {
                                Text { text: "Rolling buffer"; font-family: Theme.body-font; font-size: 12px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
                                Text { text: buffer-text; font-family: Theme.mono-font; font-size: 12px; color: Theme.text; }
                            }
                            BufferBars { fill: root.fill; count: 96; }
                            HorizontalLayout {
                                Text { text: ram-text; font-family: Theme.mono-font; font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                Text { text: encoder-line; font-family: Theme.mono-font; font-size: 10px; color: Theme.muted; }
                            }
                            Rectangle { height: 1px; background: Theme.divider; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Save clip"; font-family: Theme.body-font; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                Keys { keys: root.hotkey; padding-top: 8px; padding-bottom: 8px; }
                                Rectangle { horizontal-stretch: 1; }
                                Button { label: root.paused ? "Resume" : "Pause"; clicked => { root.toggle-pause(); } }
                                Button { label: "Save now"; primary: true; clicked => { root.save-now(); } }
                            }
                        }
                    }
                    Rectangle { height: 20px; }
                    SectionTitle { title: "BUFFER"; note: "Changes apply on the next buffer cycle, no restart."; }
                    Card {
                        VerticalLayout {
                            Row {
                                first: true;
                                title: "Length";
                                description: "How far back " + root.hotkey-text + " reaches. Longer costs more RAM.";
                                Select { options: root.length-options; index: root.length-index; selected(i) => { root.set-length(i); } }
                            }
                            Row {
                                title: "Pause when no game is running";
                                description: "Frees the encoder on the desktop.";
                                control-width: 60px;
                                Toggle { checked <=> root.pause-without-game; toggled(v) => { root.set-pause-without-game(v); } }
                            }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    alignment: start;
                    SectionTitle { title: "OUTPUT"; note: root.gpu-text; }
                    Card {
                        VerticalLayout {
                            Row {
                                first: true;
                                title: "Encoder";
                                description: root.warning != "" ? root.warning : "Hardware first. Falls back to the CPU with a warning, never silently.";
                                Select { options: root.encoder-options; index: root.encoder-index; selected(i) => { root.set-encoder(i); } }
                            }
                            Row {
                                title: "Quality";
                                description: "Target bitrate " + root.bitrate-text + ".";
                                Segmented { options: ["Light", "High", "Max"]; index: root.quality-index; selected(i) => { root.set-quality(i); } }
                            }
                            Row {
                                title: "Save to";
                                description: "Named " + root.name-example;
                                Select { custom: true; label: root.output-text; clicked-custom => { root.choose-folder(); } }
                            }
                        }
                    }
                    Rectangle { height: 20px; }
                    SectionTitle { title: "FEEDBACK"; note: "What you see after pressing the hotkey."; }
                    Card {
                        VerticalLayout {
                            Row {
                                first: true;
                                title: "On-screen toast";
                                description: "Top-right, 2.4 s. Hidden in fullscreen if the compositor blocks overlays.";
                                control-width: 60px;
                                Toggle { checked <=> root.toast; toggled(v) => { root.set-toast(v); } }
                            }
                            Row {
                                title: "Sound cue";
                                description: "Short click, routed to the default sink.";
                                control-width: 60px;
                                Toggle { checked <=> root.sound; toggled(v) => { root.set-sound(v); } }
                            }
                        }
                    }
                }
            }
            if connected && page == 1: Card {
                width: 560px;
                VerticalLayout {
                    Row {
                        first: true;
                        title: "Screen";
                        description: "Picked through the desktop portal and remembered.";
                        Button { label: "Pick again"; clicked => { root.reselect(); } }
                    }
                    Row {
                        title: "Frame rate cap";
                        description: "Restarts the encoder.";
                        Select { options: root.fps-options; index: root.fps-index; selected(i) => { root.set-fps(i); } }
                    }
                }
            }
            if connected && page == 2: Card {
                width: 560px;
                VerticalLayout {
                    Row {
                        first: true;
                        title: "Source";
                        description: "Now: " + root.audio-active + ". Desktop audio from PipeWire, or PulseAudio's monitor.";
                        Select { options: root.audio-options; index: root.audio-index; selected(i) => { root.set-audio(i); } }
                    }
                }
            }
            if connected && page == 3: Card {
                width: 560px;
                VerticalLayout {
                    Row {
                        first: true;
                        title: "Save clip";
                        description: root.hotkey-backend;
                        Keys { keys: root.hotkey; }
                    }
                    Row {
                        title: "Any other shortcut";
                        description: "Bind `clip-recorder save` in your desktop's keyboard settings. Change the hotkey with `hotkey =` in ~/.config/clip-recorder/config.";
                        control-width: 10px;
                    }
                }
            }
            if connected && page == 4: Card {
                width: 560px;
                VerticalLayout {
                    Row {
                        first: true;
                        title: "Clips folder";
                        description: root.storage-text;
                        Button { label: "Open"; clicked => { root.open-folder(); } }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
